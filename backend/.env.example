# Copy to backend/.env and fill in values. Never commit .env.

# --- App ---
APP_ENV=development
LOG_LEVEL=INFO
# Comma-separated list of allowed frontend origins
CORS_ORIGINS=http://localhost:5173

# --- Database ---
DATABASE_URL=postgresql+pg8000://clipgen:clipgen@localhost:5432/clipgen

# --- Job queue (Celery) ---
# Windows (no Redis): use PostgreSQL as the queue. Fine for a single-user tool.
CELERY_BROKER_URL=sqla+postgresql+pg8000://clipgen:clipgen@localhost:5432/clipgen
CELERY_RESULT_BACKEND=db+postgresql+pg8000://clipgen:clipgen@localhost:5432/clipgen
# With Redis available (Linux/WSL/Docker), remove the two lines above; they default to:
REDIS_URL=redis://localhost:6379/0

# --- Claude (through the Claude Code CLI; uses your logged-in subscription, no API key) ---
# Command name on PATH, or the full path to claude / claude.exe.
CLAUDE_CLI_PATH=claude
CLAUDE_CLI_TIMEOUT_SECONDS=600
CLAUDE_MODEL=claude-opus-5-5
CLAUDE_FAST_MODEL=claude-haiku-5-5

# --- Transcription (faster-whisper) ---
# Models: tiny, base, small, medium, large-v3. "small" is a good CPU default.
WHISPER_MODEL=small
# cpu | cuda | auto
WHISPER_DEVICE=cpu
# int8 for CPU; float16 or int8_float16 for CUDA
WHISPER_COMPUTE_TYPE=int8
# Spoken language code (en, ne, hi, ...). Empty = auto-detect.
WHISPER_LANGUAGE=
# 1 = fastest (greedy), 5 = beam search: a little more accurate, about 2x slower on CPU
WHISPER_BEAM_SIZE=1
# CPU threads for transcription (0 = automatic)
WHISPER_CPU_THREADS=0

# --- Media tools ---
# Command name on PATH or a full path to the executable
FFMPEG_PATH=ffmpeg
FFPROBE_PATH=ffprobe
# JavaScript runtime (Node.js) yt-dlp uses to solve YouTube challenges.
# Command name on PATH or full path, e.g. C:/Program Files/nodejs/node.exe
JS_RUNTIME_PATH=node
# Optional Netscape-format cookies file for yt-dlp (age-restricted / bot checks)
# YTDLP_COOKIES_FILE=

# --- Storage and limits ---
# Relative paths are resolved from the backend/ folder
STORAGE_DIR=storage
MAX_VIDEO_DURATION_SECONDS=10800
# Highest video resolution to download (clips are rendered at 1080x1920)
MAX_DOWNLOAD_HEIGHT=1080
# Free disk space to keep in addition to the expected download size
MIN_FREE_DISK_MB=2048
CLIP_MIN_SECONDS=20
CLIP_MAX_SECONDS=30
MAX_CLIPS_PER_VIDEO=10

# --- Cleanup (runs inside the worker) ---
# Delete downloaded source videos this many days after a job finishes (clips are kept).
# 0 = never.
SOURCE_RETENTION_DAYS=7
# Delete whole finished jobs (including clips) after this many days. 0 = never.
JOB_RETENTION_DAYS=0
CLEANUP_INTERVAL_HOURS=6

# --- Publishing ---
FRONTEND_URL=http://localhost:5173
# Encrypts saved account tokens. Empty = generated automatically in storage\secret.key
TOKEN_ENCRYPTION_KEY=
# YouTube: OAuth client from Google Cloud Console (see docs/PUBLISHING.md)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Must match an "Authorized redirect URI" of the OAuth client exactly
GOOGLE_REDIRECT_URI=http://localhost:5173/api/integrations/youtube/callback
# private | unlisted | public (unverified Google projects can only upload private videos)
YOUTUBE_DEFAULT_PRIVACY=private
YOUTUBE_CATEGORY_ID=22

# --- Rendering ---
RENDER_WIDTH=1080
RENDER_HEIGHT=1920
# x264 preset: ultrafast/superfast/veryfast/faster/fast/medium (slower = smaller files)
RENDER_PRESET=veryfast
# Quality: 18 (near lossless) ... 23 (smaller). Default 20.
RENDER_CRF=20
# Caption font; empty = automatic by language
SUBTITLE_FONT=
