# Copy to backend/.env and fill in values. Never commit .env.

# --- App ---
APP_ENV=development
LOG_LEVEL=INFO
# Comma-separated list of allowed frontend origins
CORS_ORIGINS=http://localhost:5173

# --- Database ---
DATABASE_URL=postgresql+pg8000://clipgen:clipgen@localhost:5432/clipgen

# --- Job queue (Celery) ---
# Windows (no Redis): use PostgreSQL as the queue. Fine for a single-user tool.
CELERY_BROKER_URL=sqla+postgresql+pg8000://clipgen:clipgen@localhost:5432/clipgen
CELERY_RESULT_BACKEND=db+postgresql+pg8000://clipgen:clipgen@localhost:5432/clipgen
# With Redis available (Linux/WSL/Docker), remove the two lines above; they default to:
REDIS_URL=redis://localhost:6379/0

# --- Claude (through the Claude Code CLI; uses your logged-in subscription, no API key) ---
# Command name on PATH, or the full path to claude / claude.exe.
CLAUDE_CLI_PATH=claude
CLAUDE_CLI_TIMEOUT_SECONDS=600
CLAUDE_MODEL=claude-opus-5-5
CLAUDE_FAST_MODEL=claude-haiku-5-5

# --- Transcription (faster-whisper) ---
# Models: tiny, base, small, medium, large-v3. "small" is a good CPU default.
WHISPER_MODEL=small
# cpu | cuda | auto
WHISPER_DEVICE=cpu
# int8 for CPU; float16 or int8_float16 for CUDA
WHISPER_COMPUTE_TYPE=int8

# --- Media tools ---
# Command name on PATH or a full path to the executable
FFMPEG_PATH=ffmpeg
FFPROBE_PATH=ffprobe
# JavaScript runtime (Node.js) yt-dlp uses to solve YouTube challenges.
# Command name on PATH or full path, e.g. C:/Program Files/nodejs/node.exe
JS_RUNTIME_PATH=node
# Optional Netscape-format cookies file for yt-dlp (age-restricted / bot checks)
# YTDLP_COOKIES_FILE=

# --- Storage and limits ---
# Relative paths are resolved from the backend/ folder
STORAGE_DIR=storage
MAX_VIDEO_DURATION_SECONDS=10800
CLIP_MIN_SECONDS=20
CLIP_MAX_SECONDS=30
MAX_CLIPS_PER_VIDEO=10
