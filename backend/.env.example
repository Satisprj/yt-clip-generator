# Copy to backend/.env and fill in values. Never commit .env.

# --- App ---
APP_ENV=development
LOG_LEVEL=INFO
# Comma-separated list of allowed frontend origins
CORS_ORIGINS=http://localhost:5173

# --- Database / queue (matches docker-compose.yml) ---
DATABASE_URL=postgresql+psycopg://clipgen:clipgen@localhost:5432/clipgen
REDIS_URL=redis://localhost:6379/0
# Optional: defaults to REDIS_URL
# CELERY_BROKER_URL=
# CELERY_RESULT_BACKEND=

# --- Claude API (https://console.anthropic.com) ---
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-opus-5-5
CLAUDE_FAST_MODEL=claude-haiku-5-5

# --- Transcription (faster-whisper) ---
# Models: tiny, base, small, medium, large-v3. "small" is a good CPU default.
WHISPER_MODEL=small
# cpu | cuda | auto
WHISPER_DEVICE=cpu
# int8 for CPU; float16 or int8_float16 for CUDA
WHISPER_COMPUTE_TYPE=int8

# --- Media tools ---
# Command name on PATH or a full path to the executable
FFMPEG_PATH=ffmpeg
FFPROBE_PATH=ffprobe
# Optional Netscape-format cookies file for yt-dlp (age-restricted / bot checks)
# YTDLP_COOKIES_FILE=

# --- Storage and limits ---
# Relative paths are resolved from the backend/ folder
STORAGE_DIR=storage
MAX_VIDEO_DURATION_SECONDS=10800
CLIP_MIN_SECONDS=20
CLIP_MAX_SECONDS=30
MAX_CLIPS_PER_VIDEO=10
